{
	"name": "agriculture-website",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "oxlint --deny-warnings .",
		"lint:fix": "oxlint --fix .",
		"format": "oxfmt --write .",
		"format:check": "oxfmt --check .",
		"test:unit": "vitest",
		"test": "pnpm run test:unit --run"
	},
	"devDependencies": {
		"@fontsource/alata": "^5.3.0",
		"@fontsource/lato": "^5.3.0",
		"@inlang/paraglide-js": "^2.18.2",
		"@lucide/svelte": "^1.55.0",
		"@shadcn/lint": "^0.2.1",
		"@sveltejs/adapter-static": "^4.0.0",
		"@sveltejs/enhanced-img": "^1.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/typography": "^0.5.19",
		"@tailwindcss/vite": "^4.3.0",
		"@types/node": "^26.6.5",
		"@vitest/browser-playwright": "^4.1.8",
		"cn": "^0.4.0",
		"html-to-image": "^1.11.13",
		"mdsvex": "^0.12.7",
		"oxfmt": "^0.72.0",
		"oxlint": "^1.87.0",
		"playwright": "^1.60.0",
		"shadcn-svelte": "^1.7.0",
		"svelte": "^5.57.1",
		"svelte-check": "^4.6.0",
		"svelte-grab": "^1.4.2",
		"tailwind-variants": "^3.3.1",
		"tailwindcss": "^4.3.0",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.3",
		"vite": "^8.3.0",
		"vitest": "^4.1.8",
		"vitest-browser-svelte": "^2.1.1"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
